ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://itsm_workflow:change-me@127.0.0.1:5432/itsm_workflow
LANGGRAPH_DATABASE_URL=postgresql://itsm_workflow:change-me@127.0.0.1:5432/itsm_workflow
AOPS_BASE_URL=https://aops.internal/aops/api
AOPS_CA_BUNDLE=
AOPS_CLI_PATH=/usr/local/bin/aops-cli
AOPS_CLI_VERSION_REQUIREMENT=
EMBEDDING_BASE_URL=http://embedding.internal/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_BASE_URL=http://rerank.internal/v1
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_PATH=/rerank
RERANK_API_FORMAT=auto
WORKFLOW_API_TOKEN=replace-with-long-random-token
WORKFLOW_MASTER_KEY=replace-with-base64-encoded-32-byte-key
WORKFLOW_ADMIN_UIDS=S000001
WORKFLOW_OPERATOR_UIDS=S000001
WORKER_CONCURRENCY=2
WORKER_LEASE_SECONDS=30
NODE_TIMEOUT_SECONDS=600
CREDENTIAL_TTL_HOURS=8
RESULT_RETENTION_DAYS=30
SESSION_COOKIE_SECURE=false
STATIC_DIR=frontend/dist
