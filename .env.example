ENVIRONMENT=development
AOPS_BASE_URL=https://aops.internal/aops/api
AOPS_CA_BUNDLE=
AOPS_CLI_PATH=/usr/local/bin/aops-cli
AOPS_CLI_VERSION_REQUIREMENT=

LLM_BASE_URL=http://llm.internal/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_PATH=/chat/completions
LLM_RESPONSE_FORMAT=auto

RUNTIME_SERVICE_TOKEN=
STUDIO_ADMIN_TOKEN=change-me
STUDIO_SESSION_HOURS=8
STUDIO_COOKIE_SECURE=false

TEC01_BASE_URL=
TEC01_SERVICE_TOKEN=
TEC01_RUN_CALLBACK_PATH=/internal/v1/runs/{runId}/callbacks
TEC01_EXTRACTION_CALLBACK_PATH=/internal/v1/extractions/{knowledgeId}/callbacks
TEC01_TIMEOUT_SECONDS=20
TEC01_CALLBACK_MAX_ATTEMPTS=6
TEC01_CALLBACK_WAIT_SECONDS=70

# Operational logs only; business records remain in browser IndexedDB.
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_RETENTION_DAYS=7
LOG_MAX_TOTAL_MB=512
LOG_MAX_FILE_MB=16
LOG_CLEANUP_INTERVAL_SECONDS=60
EXECUTOR_ID=executor-01
EXECUTOR_MAX_ACTIVE_RUNS=8
EXECUTOR_MAX_ACTIVE_CLI=2
COMPILER_MAX_ACTIVE_JOBS=1
CPU_MAX_WORKERS=1
RUNTIME_DATA_BUDGET_MB=2048
EXECUTOR_RUN_MEMORY_MB=256
COMPILER_CACHE_MAX_MB=64
REQUEST_MAX_BODY_MB=64
COMPILER_EVIDENCE_MAX_MB=8
COMPILER_MAX_AUDIT_OPERATIONS=5000
COMPILER_MODEL_INPUT_MAX_CHARS=24000
SQL_TEMPLATE_MAX_CHARS=65536
TEC01_HTTP_MAX_CONNECTIONS=16
TEC01_HTTP_MAX_KEEPALIVE=8

NODE_TIMEOUT_SECONDS=600
STATIC_DIR=frontend/dist
WORKFLOW_BASE_PATH=
