ENVIRONMENT=production
KNOWLEDGE_ENVIRONMENT_NAME=production
DATABASE_URL=postgresql+asyncpg://itsm_workflow:replace-password@postgres.internal:5432/itsm_workflow
LANGGRAPH_DATABASE_URL=postgresql://itsm_workflow:replace-password@postgres.internal:5432/itsm_workflow
AOPS_BASE_URL=https://aops.internal/aops/api
AOPS_CA_BUNDLE=/etc/pki/tls/certs/ca-bundle.crt
AOPS_CLI_PATH=/usr/local/bin/aops-cli
AOPS_CLI_VERSION_REQUIREMENT=
EMBEDDING_BASE_URL=http://embedding.internal/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_BASE_URL=http://rerank.internal/v1
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_PATH=/rerank
RERANK_API_FORMAT=auto
LLM_BASE_URL=http://llm.internal/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_PATH=/chat/completions
LLM_RESPONSE_FORMAT=auto
WORKFLOW_API_TOKEN=replace-with-long-random-token
WORKFLOW_REVIEW_TOKEN=replace-with-separate-review-token
WORKFLOW_REVIEW_ACTOR_UID=workflow-review-service
WORKFLOW_PUBLIC_URL=http://workflow.internal:8089
MCP_INTERNAL_API_URL=http://127.0.0.1:8089/api/v1
MCP_BIND_HOST=127.0.0.1
MCP_PORT=8090
MCP_PATH=/mcp
MCP_ALLOWED_HOSTS=workflow.internal:*,127.0.0.1:*,localhost:*
MCP_WAIT_MAX_SECONDS=15
WORKFLOW_MASTER_KEY=replace-with-base64-encoded-32-byte-key
WORKFLOW_ADMIN_UIDS=replace-with-admin-uids
WORKFLOW_OPERATOR_UIDS=replace-with-operator-uids
WORKER_CONCURRENCY=2
WORKER_LEASE_SECONDS=30
NODE_TIMEOUT_SECONDS=600
CREDENTIAL_TTL_HOURS=8
RESULT_RETENTION_DAYS=30
SESSION_COOKIE_SECURE=false
STATIC_DIR=frontend/dist
WORKFLOW_BIND_HOST=0.0.0.0
WORKFLOW_PORT=8089
WORKFLOW_BASE_PATH=
