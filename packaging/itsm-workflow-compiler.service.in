[Unit]
Description=ITSM Workflow Compiler Worker for tec01
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
WorkingDirectory=__PREFIX__
EnvironmentFile=__CONFIG_DIR__/service.env
Environment=PYTHONPATH=__PREFIX__/site-packages:__PREFIX__
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=__PREFIX__/python/bin/python3 -m app.compiler_worker
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
